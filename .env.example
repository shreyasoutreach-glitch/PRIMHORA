# Root-level environment overrides for docker compose.

# --- Local PostgreSQL (docker compose only) ---
POSTGRES_USER=primhora
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=primhora

# --- Backend ---
DEMO_MODE=true
SEED=42

# Neon is used by deployed production. Do not commit the real connection string.
# Render should receive the Neon pooled DATABASE_URL as a secret.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-...pooler...neon.tech/DBNAME?sslmode=require

# Optional: only needed if you wire in real vision/OCR evidence extraction.
ANTHROPIC_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=
