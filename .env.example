# Root-level environment overrides for docker compose.

# --- Local PostgreSQL (docker compose only) ---
POSTGRES_USER=primhora
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=primhora

# --- Backend ---
DEMO_MODE=true
SEED=42

# Production uses Supabase PostgreSQL. Do not commit the real connection string.
# Render receives the Supabase Session Pooler DATABASE_URL as a secret.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional: only needed if you wire in real vision/OCR evidence extraction.
ANTHROPIC_API_KEY=

# --- Frontend ---
# Production uses the Vercel /api boundary to reach the Render API.
VITE_API_BASE_URL=
