# Primhora backend configuration

# Production runtime credential: must be a non-owner role that inherits
# primhora_runtime (NOLOGIN, NOBYPASSRLS). Keep this separate from migrations.
# DATABASE_URL=postgresql://primhora_app.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Production DDL credential: used by Alembic only. Keep the owner/migration
# credential here, never in the application runtime URL.
# MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Local Docker: docker-compose injects this automatically.
DATABASE_URL=postgresql+psycopg2://primhora:change_me_locally@localhost:5432/primhora

DEMO_MODE=true
# Destructive whole-database reset is disabled unless explicitly enabled locally.
DEMO_ALLOW_GLOBAL_RESET=false
# Keep false on any shared/public demo; customer uploads require production OIDC.
DEMO_ALLOW_EXTERNAL_INGESTION=false
DEMO_BOOTSTRAP_ON_START=false
SEED=42
EVIDENCE_STORAGE_DIR=./storage/evidence
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5173

# Razorpay webhook is bound to one tenant. Configure all three values together.
RAZORPAY_MERCHANT_ID=
RAZORPAY_TENANT_ID=
RAZORPAY_WEBHOOK_SECRET=
