# Primhora backend configuration

# Production: Neon PostgreSQL connection string.
# Use Neon's pooled connection string for the application runtime.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-...pooler...neon.tech/DBNAME?sslmode=require

# Local Docker: docker-compose injects this automatically.
DATABASE_URL=postgresql+psycopg2://primhora:change_me_locally@localhost:5432/primhora

DEMO_MODE=true
SEED=42
EVIDENCE_STORAGE_DIR=./storage/evidence
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5173
