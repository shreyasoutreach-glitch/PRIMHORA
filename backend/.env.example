# Primhora backend configuration

# Production: Supabase PostgreSQL Session Pooler connection string.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Local Docker: docker-compose injects this automatically.
DATABASE_URL=postgresql+psycopg2://primhora:change_me_locally@localhost:5432/primhora

DEMO_MODE=true
SEED=42
EVIDENCE_STORAGE_DIR=./storage/evidence
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5173
